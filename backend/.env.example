DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27019/?replicaSet=nexora
MONGODB_DATABASE=nexora_hub
FRONTEND_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Nexora <noreply@hub.local>
# Résumés et illustrations — laisser vide pour désactiver la génération IA.
REVISIONS_GEMINI_MODEL=gemini-3.5-flash
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# Space public Hugging Face (quota GPU gratuit) ; vide = API Inference Providers payante.
HF_IMAGE_SPACE=black-forest-labs/FLUX.1-schnell
AI_TIMEOUT_SECONDS=90
# Secours local pour les résumés si Gemini échoue (vide = désactivé).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
# Traitement asynchrone des générations IA : Celery + Redis (vide = file de threads intégrée).
CELERY_BROKER_URL=
# Assistant pédagogique (GEMINI_API_KEY est partagée avec Résumés et illustrations).
WHISPER_PROVIDER=disabled
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=2
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
COURSES_MAX_AUDIO_SECONDS=7200
ASSISTANT_LLM_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=45
ASSISTANT_MIN_SCORE=1.0
ASSISTANT_DAILY_QUESTIONS=30
ASSISTANT_GLOBAL_DAILY_BUDGET=400
ASSISTANT_VOICE_PER_HOUR=20
ASSISTANT_MAX_AUDIO_SECONDS=60
ASSISTANT_MAX_AUDIO_MB=5
ASSISTANT_QUIZ_LOCK_HOURS=3
