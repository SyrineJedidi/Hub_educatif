DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27019/?replicaSet=nexora
MONGODB_DATABASE=nexora_hub
FRONTEND_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Nexora <noreply@hub.local>
# Résumés et illustrations — laisser vide pour désactiver la génération IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# Space public Hugging Face (quota GPU gratuit) ; vide = API Inference Providers payante.
HF_IMAGE_SPACE=black-forest-labs/FLUX.1-schnell
AI_TIMEOUT_SECONDS=90
# Secours local pour les résumés si Gemini échoue (vide = désactivé).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
# Traitement asynchrone des générations IA : Celery + Redis (vide = file de threads intégrée).
CELERY_BROKER_URL=
