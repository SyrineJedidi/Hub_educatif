# Copy to deploy/.env.production and fill in. Never commit the real file.
# --- Django -------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Public domain(s) + "backend" (name of the container, used by nginx and the health check).
DJANGO_ALLOWED_HOSTS=hub.example.org,backend,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://hub.example.org
FRONTEND_URL=https://hub.example.org
# Behind an HTTPS proxy (recommended): keep these three lines as they are.
DJANGO_BEHIND_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
# Local trial over plain HTTP on http://localhost:8080 only:
#   DJANGO_SECURE_SSL_REDIRECT=false  and  CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- Database and queue ---------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/?replicaSet=nexora
MONGODB_DATABASE=nexora_hub
CELERY_BROKER_URL=redis://redis:6379/0

# --- E-mail (password reset, verification) ---------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Nexora <noreply@hub.example.org>

# --- Artificial intelligence (empty = the feature is hidden, manual editing still works) ---
GEMINI_API_KEY=
REVISIONS_GEMINI_MODEL=gemini-3.5-flash
HF_TOKEN=
HF_IMAGE_SPACE=black-forest-labs/FLUX.1-schnell
AI_TIMEOUT_SECONDS=90
# Optional local fallback: an Ollama server reachable from the containers.
OLLAMA_URL=
# Partagé par les Résumés (secours) et les Quiz (génération de questions).
OLLAMA_BASE_URL=
# Quiz question generation runs in the Celery worker (false = inside the request).
QUIZ_GENERATION_ASYNC=true
OLLAMA_MODEL=

# --- Teaching assistant (Assistant pédagogique) ---------------------------------
# Answers: disabled, fake (canned answers, for a trial without a key) or gemini (uses GEMINI_API_KEY above).
ASSISTANT_LLM_PROVIDER=disabled
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the first model is out of quota: each model has its own free quota.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Per call; keep it well under the 120 s request timeout of nginx and gunicorn.
GEMINI_TIMEOUT_SECONDS=45
# Course excerpts scoring below this are ignored; none left = "out of scope", answered without calling Gemini.
ASSISTANT_MIN_SCORE=1.0
# Questions per student and course per day (a teacher can lower it), and for the whole site (Gemini quota).
ASSISTANT_DAILY_QUESTIONS=30
ASSISTANT_GLOBAL_DAILY_BUDGET=400
# A quiz in progress closes the assistant to the student; without a deadline, for this many hours.
ASSISTANT_QUIZ_LOCK_HOURS=3
# Voice questions per student per hour, and limits of one recording (nginx accepts up to 12 MB).
ASSISTANT_VOICE_PER_HOUR=20
ASSISTANT_MAX_AUDIO_SECONDS=60
ASSISTANT_MAX_AUDIO_MB=5
# Transcription: disabled, local or groq (needs GROQ_API_KEY).
# local needs the image built with: WITH_WHISPER=true docker compose up -d --build
# The model is downloaded on the first voice question (volume whisper-models); each gunicorn worker loads its own copy.
WHISPER_PROVIDER=disabled
WHISPER_MODEL=small
WHISPER_CPU_THREADS=2
# Empty = detected on each recording; fr forces French.
WHISPER_LANGUAGE=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Longest recording the transcription accepts at all (course recordings); voice questions stop at ASSISTANT_MAX_AUDIO_SECONDS.

# --- Planification des révisions (Gemini, mêmes clé et modèles que l’assistant) ---
GEMINI_PROVIDER=disabled
PLANNING_AI_DAILY_LIMIT=10
PLANNING_AI_DAILY_BUDGET=400

# --- Cours et ressources : traités par le service courses-worker ---
COURSES_MAX_PDF_MB=20
COURSES_MAX_AUDIO_MB=25
COURSES_MAX_PDF_PAGES=300
COURSES_MAX_AUDIO_SECONDS=7200

# --- Comptes : confirmation par email et anti-robot ---
# Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true, EMAIL_HOST_USER=adresse Gmail,
# EMAIL_HOST_PASSWORD=mot de passe d’application (compte Google > Sécurité > Mots de passe des applications).
EMAIL_VERIFICATION_REQUIRED=true
# Anti-robot ALTCHA : aucune clé externe ; ALTCHA_HMAC_KEY vide = dérivée de DJANGO_SECRET_KEY.
CAPTCHA_ENABLED=true
ALTCHA_HMAC_KEY=
